{
  "name": "ai-department",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/main.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && node scripts/check-client.mjs && node scripts/check-exporter.mjs && node scripts/build-figma-exporter.mjs && vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit && node scripts/check-client.mjs && node scripts/check-exporter.mjs",
    "build:exporter": "node scripts/build-figma-exporter.mjs",
    "typecheck:exporter": "node scripts/check-exporter.mjs",
    "typecheck:client": "node scripts/check-client.mjs",
    "test": "vitest run",
    "test:reliability": "node scripts/test-reliability.mjs",
    "eval": "tsx src/evaluation/cli.ts",
    "attest": "tsx src/server/attest.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "fastify": "5.6.2",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.9.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
